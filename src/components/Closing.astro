---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/palegio-logo-branca.png';
import faq from '../faq.json';
import { CONTACT } from '../data';
---
<section class="section surface">
  <div class="wrap faq-grid">
    <div class="reveal">
      <p class="eyebrow">Dúvidas</p>
      <h2 class="h2" style="margin-top:16px">Perguntas frequentes</h2>
      <p class="lead">As respostas para o que os gestores mais perguntam antes de contratar.</p>
      <a href={CONTACT.whatsapp} class="btn-ghost wa-link" target="_blank" rel="noopener">Falar com a equipe no WhatsApp <Icon name="arrow" size={18} /></a>
    </div>
    <div class="faq">
      {faq.map((f, i) => (
        <details class="reveal" open={i === 0}>
          <summary>{f.q}<Icon name="chevron" class="chev" size={20} /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="final dark">
  <div class="wrap final-in reveal">
    <div class="final-date tnum" aria-hidden="true"><b>30</b><span>out<br />2026</span></div>
    <div>
      <h2 class="h2">O prazo para definir o recolhimento do IBS e da CBS foi prorrogado até <span class="hl">30 de outubro de 2026</span>.</h2>
      <p class="lead">Adesões garantidas somente até 28 de outubro de 2026. O prazo legal para a opção pelo regime regular termina em 30 de outubro.</p>
      <button type="button" class="btn btn-lg" data-open style="margin-top:32px">Garantir meu diagnóstico estratégico agora <Icon name="arrow" /></button>
    </div>
  </div>
</section>

<footer class="footer" id="contato">
  <div class="wrap footer-in">
    <Image src={logo} alt="Palegio consultoria tributária" width={140} />
    <nav aria-label="Redes sociais" class="social">
      <a href={CONTACT.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
      <a href={CONTACT.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
    </nav>
    <p class="legal">© 2026 PALEGIO INTELIGENCIA TRIBUTARIA LTDA · CNPJ 33.522.019/0001-57</p>
  </div>
</footer>

<a href={CONTACT.whatsapp} class="wa" target="_blank" rel="noopener" aria-label="Falar com a Palegio no WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43zm8.03-17.46A11.27 11.27 0 0 0 12.05.7C5.79.7.7 5.79.7 12.05c0 2 .52 3.95 1.52 5.67L.6 23.3l5.72-1.5a11.33 11.33 0 0 0 5.72 1.46h.01c6.26 0 11.35-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02z"/></svg>
</a>

<div class="mbar" data-mbar>
  <p><b>Prazo: 28/10</b><span class="tnum"><span data-cd="d">--</span>d <span data-cd="h">--</span>h restantes</span></p>
  <a href="#triagem" class="btn btn-sm">Fazer triagem</a>
</div>

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .faq-grid > div:first-child { position: sticky; top: 110px; }
  .wa-link { margin-top: 28px; }
  .faq { display: grid; gap: 12px; }
  details { background: var(--bg); border: 1px solid var(--line); border-radius: 16px; transition: border-color .2s, box-shadow .2s; }
  details[open] { border-color: oklch(64.3% 0.18 145 / 0.4); box-shadow: var(--shadow); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 24px; cursor: pointer; list-style: none; font-size: 17px; font-weight: 700; line-height: 1.4; }
  summary::-webkit-details-marker { display: none; }
  summary :global(.chev) { flex: none; color: var(--ink-3); transition: transform .25s var(--ease); }
  details[open] summary :global(.chev) { transform: rotate(180deg); color: var(--green-ink); }
  details p { padding: 0 24px 24px; font-size: 16px; line-height: 1.75; color: var(--ink-2); }

  .final { padding-block: clamp(72px, 9vw, 112px); position: relative; overflow: hidden; }
  .final::before { content: ''; position: absolute; inset: auto auto -50% -10%; width: 60%; aspect-ratio: 1; background: radial-gradient(closest-side, oklch(64.3% 0.18 145 / 0.2), transparent); }
  .final-in { position: relative; display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .final-date { display: flex; align-items: center; gap: 14px; padding: 28px 32px; border-radius: 24px; background: var(--green); color: oklch(14% 0.03 150); }
  .final-date b { font-size: clamp(4rem, 9vw, 6.5rem); font-weight: 800; line-height: .9; letter-spacing: -0.05em; }
  .final-date span { font-size: 18px; font-weight: 800; line-height: 1.15; text-transform: uppercase; letter-spacing: .04em; }

  .footer { background: var(--dark); color: var(--on-dark-3); border-top: 1px solid var(--dark-line); padding: 40px 0 120px; }
  .footer-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .social { display: flex; gap: 8px; }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--dark-line); color: var(--on-dark-2); transition: background .2s, color .2s; }
  .social a:hover { background: oklch(100% 0 0 / 0.06); color: var(--green-hi); }
  .legal { flex-basis: 100%; font-size: 13px; }

  .wa { position: fixed; right: 20px; bottom: 20px; z-index: 45; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: #25D366; color: #fff; box-shadow: 0 12px 30px -8px rgb(0 0 0 / .4); transition: transform .2s var(--ease); }
  .wa:hover { transform: scale(1.06); }

  .mbar { display: none; }
  @media (max-width: 860px) {
    .faq-grid, .final-in { grid-template-columns: 1fr; }
    .faq-grid > div:first-child { position: static; }
    .final-date { justify-self: start; padding: 18px 22px; }
    summary { padding: 18px 20px; font-size: 16px; }
    details p { padding: 0 20px 20px; }
    .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 44; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: oklch(12% 0.006 155 / 0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--dark-line); color: var(--on-dark); transform: translateY(110%); transition: transform .3s var(--ease); }
    .mbar.show { transform: none; }
    .mbar p { display: grid; font-size: 13px; line-height: 1.35; }
    .mbar p > span { color: var(--on-dark-3); }
    .mbar .btn { min-height: 44px; padding: 0 20px; font-size: 15px; }
    .wa { bottom: 84px; right: 16px; width: 52px; height: 52px; }
  }
</style>
